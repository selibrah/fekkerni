{
  "name": "fekkerni",
  "version": "0.1.0",
  "description": "Fekkerni \u2014 turn an Instagram creator's content into a DM-searchable knowledge base.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "search": "tsx src/scripts/search.ts",
    "eval": "tsx src/scripts/eval.ts",
    "backfill": "tsx src/scripts/backfill.ts",
    "poll": "tsx src/scripts/poll.ts",
    "poll-all": "tsx src/scripts/poll-all.ts",
    "refresh": "tsx src/scripts/refresh-tokens.ts"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/selibrah/fekkerni.git"
  }
}
