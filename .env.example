# ── Fekkerni environment ──────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. All real secrets live in Secret
# Manager in production; .env is for local dev only.

# ── Meta / Instagram (Instagram API with Instagram Login) ─────────────────────
META_APP_SECRET=                 # App Secret — used to validate X-Hub-Signature-256
VERIFY_TOKEN=                    # Arbitrary string you also set in the Meta webhook config
IG_GRAPH_VERSION=v25.0           # Current stable Graph API version (re-confirm at build time)
IG_GRAPH_BASE=https://graph.instagram.com

# ── Gemini (@google/genai) ────────────────────────────────────────────────────
# Auth: set GEMINI_API_KEY for the Developer API, OR set GENAI_USE_VERTEX=true plus
# GOOGLE_CLOUD_PROJECT/GOOGLE_CLOUD_LOCATION for Vertex AI (uses ADC).
GEMINI_API_KEY=
GENAI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Models (env-driven on purpose; re-confirm ids at build time — the Flash line moves fast)
FLASH_MODEL=gemini-3.5-flash     # GA Flash. Do NOT use gemini-2.5-flash (shutdown 2026-10-16)
INDEX_MODEL=gemini-3.5-flash     # Model used for video transcription/indexing (can be cheaper, e.g. gemini-3.1-flash-lite)
EMBED_MODEL=gemini-embedding-001 # 001 => manual L2-normalize required (handled in code)
EMBED_DIMS=768                   # Must match the Firestore vector index dimension

# ── Retrieval ─────────────────────────────────────────────────────────────────
# COSINE distance in [0,2]; SMALLER = closer. Top-result distance ABOVE this => fallback.
COSINE_DISTANCE_MAX=0.4

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE_ID=(default)
# For local dev against the Firestore emulator, set FIRESTORE_EMULATOR_HOST=localhost:8080

# ── Async processing / queue ──────────────────────────────────────────────────
# QUEUE_DRIVER=local runs jobs in-process (dev/smoke). QUEUE_DRIVER=cloudtasks uses Cloud Tasks.
QUEUE_DRIVER=local
CLOUD_TASKS_QUEUE=fekkerni-jobs
CLOUD_TASKS_LOCATION=us-central1
WORKER_BASE_URL=                 # Public URL of this service, for Cloud Tasks to call back (e.g. https://fekkerni-xxxx.run.app)
WORKER_OIDC_SERVICE_ACCOUNT=     # Service account email Cloud Tasks uses to mint OIDC tokens for the worker

# ── Secrets driver ────────────────────────────────────────────────────────────
# SECRETS_DRIVER=local reads creator tokens from .env (CREATOR_TOKEN_<creatorId>) for dev.
# SECRETS_DRIVER=secretmanager stores/reads per-creator tokens in Secret Manager.
SECRETS_DRIVER=local

# ── Indexing cost guards ──────────────────────────────────────────────────────
MAX_BACKFILL_VIDEOS=200          # Hard cap on videos transcribed per creator backfill (newest first)
BACKFILL_COST_CEILING_USD=25     # Soft ceiling; backfill estimates cost and stops/flags above this
INDEX_IMAGE_DESCRIPTIONS=false   # Toggle: enrich image posts with a one-line Gemini description

# ── Behaviour ─────────────────────────────────────────────────────────────────
MESSAGING_WINDOW_HOURS=24        # Standard messaging window
MAX_REPLY_BYTES=1000             # Meta hard cap on outbound message text (UTF-8 bytes)
LOG_LEVEL=info
